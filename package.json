{
  "name": "warera-lab",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "workspaces": [
    "packages/domain",
    "packages/warera-api",
    "packages/simulation-core",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run build:apps",
    "build:packages": "npm run build -w @warera-lab/domain && npm run build -w @warera-lab/warera-api && npm run build -w @warera-lab/simulation-core",
    "build:apps": "npm run build -w @warera-lab/api && npm run build -w @warera-lab/web",
    "dev:api": "npm run build:packages && npm run dev -w @warera-lab/api",
    "dev:web": "npm run dev -w @warera-lab/web",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.{ts,json}\" \"tests/**/*.{ts,tsx,json}\" \"*.{json,js,mjs,ts}\" \".github/**/*.yml\" \"docs/adr/**/*.md\" \"docs/RELEASE_CANDIDATE.md\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.{ts,json}\" \"tests/**/*.{ts,tsx,json}\" \"*.{json,js,mjs,ts}\" \".github/**/*.yml\" \"docs/adr/**/*.md\" \"docs/RELEASE_CANDIDATE.md\"",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.tests.json --noEmit",
    "verify": "npm run format:check && npm run lint && npm run build && npm run typecheck && npm run test && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "type": "module"
}
